# ApplyRank backend - settings template
# This file only shows the NAMES of the settings. It has no real secrets.
#
# How to use (Windows PowerShell, in the same terminal where you run the backend):
#   $env:GEMINI_API_KEY = "paste-your-real-key-here"
#   mvn spring-boot:run
#
# NEVER write a real key or password inside this file or commit it to GitHub.
# Every setting below is optional. The app also runs without any of them
# (H2 test database, no AI, reset links printed in the terminal).

# --- AI Lab (optional) ---
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_HOURLY_QUOTA=10

# --- MySQL (only when you run with:  mvn spring-boot:run -Dspring-boot.run.profiles=mysql) ---
DB_URL=jdbc:mysql://localhost:3306/applyrank?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=your-mysql-password-here

# --- Security (set a long random value before deploying) ---
# Make one in PowerShell:
#   $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=use-a-long-random-text-here-at-least-32-characters

# --- LIVE SERVER ONLY (Render). See docs/DEPLOY.md ---
# prod = safe live settings. mysql = use the real database (DB_URL, DB_USER, DB_PASSWORD above).
# With "prod" the server REFUSES to start if JWT_SECRET is weak.
SPRING_PROFILES_ACTIVE=prod,mysql
# Passwords for the two demo logins on the live server. If you leave them empty the accounts get a random password nobody knows.
DEMO_CANDIDATE_PASSWORD=
DEMO_RECRUITER_PASSWORD=
# TiDB Cloud (free MySQL-compatible database) needs an encrypted connection and uses port 4000:
#   DB_URL=jdbc:mysql://<your-host>.tidbcloud.com:4000/applyrank?sslMode=VERIFY_IDENTITY&serverTimezone=UTC

# --- Frontend address and CORS ---
FRONTEND_URL=http://127.0.0.1:5500
CORS_ORIGINS=http://127.0.0.1:*,http://localhost:*
REQUIRE_VERIFIED_EMAIL=false
RATE_LIMIT_PER_MINUTE=300

# --- E-mail (optional; without it the links are printed in the terminal) ---
# Gmail needs an "App Password", not your normal password.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=you@gmail.com
SPRING_MAIL_PASSWORD=your-16-char-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=no-reply@applyrank.dev
